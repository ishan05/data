#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

test -s README.md
test -s mobileinterviewmock.drawio
python3 - <<'PY'
from pathlib import Path
from xml.etree import ElementTree

root = ElementTree.parse("mobileinterviewmock.drawio").getroot()
if root.tag != "mxfile":
    raise SystemExit("draw.io document must have an mxfile root")
if not root.findall("diagram"):
    raise SystemExit("draw.io document must contain at least one diagram")

readme = Path("README.md").read_text()
if not readme.lstrip().startswith("#"):
    raise SystemExit("README must start with a heading")
PY
